/.venv/
*.unw
*.unw.ers
*npy
*.egg-info/
.pytest_cache/

# run artifacts (checkpoints, pickled test sets, reconstructions, shapefiles)
/models
/outputs/
/test_data/
/out_polygs/

# on WEXAC: the scene symlink farms (data/scenes_11day, read by scripts/data/*.sh);
# on a laptop: downloaded patches and the train-ready tree (prepare-local-subset)
/data/

# LSF scheduler stdout/stderr from the scripts/ jobs (the directory itself stays tracked)
/logs/*
!/logs/.gitkeep

.DS_Store
._*
__pycache__/

# regeneration backups (JSON side-cars, timestamped)
/backups/

# Claude Code local state (worktrees, session settings)
/.claude/

# Local safety copies made before large edits; not version-controlled.
*.bak
*.bak[0-9]

# Status decks: kept on disk, out of git
docs/reference/*.pptx

# HPO study roots (ledger, runs, evaluations, caches) -- protected study state, never in git
/studies/
